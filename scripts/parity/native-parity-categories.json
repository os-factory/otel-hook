      "documented": {
        "token.input": {
          "status": "impossible",
          "note": "no Claude Code hook carries a token counter (docs/claude-code-usage-contract.md); the adapter may not read the transcript"
        },
        "token.output": {
          "status": "impossible",
          "note": "as token.input"
        },
        "token.cache_read": {
          "status": "impossible",
          "note": "as token.input"
        },
        "token.cache_write": {
          "status": "impossible",
          "note": "as token.input"
        },
        "cost": {
          "status": "impossible",
          "note": "no tokens and no cost in any hook; otel-hook exports no cost attribute"
        },
        "model": {
          "status": "partial",
          "note": "session.start log carries gen_ai.request.model from SessionStart.model; per-turn generation model is 'unknown'"
        },
        "api.requests": {
          "status": "impossible",
          "note": "hooks fire per turn (Stop), not per API request"
        },
        "api.latency": {
          "status": "impossible",
          "note": "as api.requests"
        },
        "errors": {
          "status": "partial",
          "note": "StopFailure -> generation outcome + stop_reason, PostToolUseFailure -> tool error; no HTTP status, no api_error"
        },
        "retries": {
          "status": "impossible",
          "note": "no hook reports API attempts"
        },
        "tool.calls": {
          "status": "covered"
        },
        "tool.decision": {
          "status": "derivable",
          "note": "PermissionRequest is ignored today; a PermissionRequest without a later PostToolUse implies denied/aborted. Decision source is impossible"
        },
        "tool.duration": {
          "status": "partial",
          "note": "span duration is PreToolUse-to-PostToolUse hook time, which includes permission wait"
        },
        "tool.result": {
          "status": "covered",
          "note": "ok/error from PostToolUse vs PostToolUseFailure; sizes only as content byte_length on logs"
        },
        "prompts": {
          "status": "covered",
          "note": "length and salted hash; text only with content opt-in"
        },
        "turns": {
          "status": "partial",
          "note": "one generation span per Stop; no per-turn model or tokens"
        },
        "compaction": {
          "status": "partial",
          "note": "PostCompact trigger; no pre/post tokens, success or duration"
        },
        "session.start": {
          "status": "covered",
          "note": "session.start log; session span only once SessionEnd arrives"
        },
        "session.end": {
          "status": "not-native",
          "note": "otel-hook-only: SessionEnd with reason"
        },
        "lines_of_code": {
          "status": "derivable",
          "note": "count lines from Edit/Write/MultiEdit tool input or structuredPatch in PostToolUse"
        },
        "commits": {
          "status": "derivable",
          "note": "successful Bash PostToolUse running git commit (heuristic)"
        },
        "pull_requests": {
          "status": "derivable",
          "note": "successful Bash PostToolUse running gh pr create (heuristic)"
        },
        "active_time": {
          "status": "derivable",
          "note": "CLI time from prompt-to-Stop intervals; user (keyboard) time is impossible"
        },
        "subagents": {
          "status": "partial",
          "note": "SubagentStart/SubagentStop spans with type; no tokens or tool counts"
        }
      }
