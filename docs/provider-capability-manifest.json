      "deliveryIdentifier": "partial",
      "registrationSupported": true,
      "registrationNote": "the ~/.cursor/hooks.json and .cursor/hooks.json documents, their shape, and the event vocabulary are documented at cursor.com/docs/agent/hooks, and the payload contract this adapter parses is derived from that reference plus four real redacted capture runs (Cursor IDE 3.12.17 and CLI 2026.07.17, recorded in providers/cursor/payload.ts and replayed from fixtures/parity/cursor)",
      "registrationHelper": "mergeCursorHookRegistration",
