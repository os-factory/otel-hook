# CLI / library harness for @osfactory/otel-hook
# Generated by har env init --profile cli, then adapted.
#
# This file is pure KEY=value config (plus comments) and is schema-validated
# on read. Runtime helpers live in .har/lib/ — never define functions here.

export HARNESS_PROJECT_NAME=otel_hook
export HARNESS_USE_WORKTREE=true

# Optional per-slot HTTP ports for integration tests. Unused: this package is a
# library/CLI with no local HTTP server. Left at schema defaults so launch can
# still write them into .env.agent.<id> if a future test server appears.
export HARNESS_FE_BASE_PORT=3000
export HARNESS_API_BASE_PORT=8000
export HARNESS_PORT_STEP=10
export HARNESS_HEALTH_CHECK_PATH=

# Shared infra host ports. Unused while HARNESS_INFRA_SERVICES is empty.
export HARNESS_INFRA_PORT_LANES="db=15432:15432-15499"

export HARNESS_AGENT_SLOT_MIN=1
export HARNESS_AGENT_SLOT_MAX=3

# Toolchain provisioning — launch writes resolved paths into .env.agent.<id>
export HARNESS_ECOSYSTEM="node"
export HARNESS_NODE_PACKAGE_MANAGER="npm"
export HARNESS_INSTALL_CMD="npm ci"

# No Docker: this library has no database, object store, mail, or browser.
export HARNESS_INFRA_SERVICES=""
export HARNESS_DB_MIGRATE_CMD=""
export HARNESS_DB_SEED_CMD=""
